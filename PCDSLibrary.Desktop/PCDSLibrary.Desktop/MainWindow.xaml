<Window x:Class="PCDSLibrary.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PCDSLibrary.Desktop.Views"
        Title="PCDS Library"
        Icon="/Assets/pcds-seal.png"
        Width="1080"
        Height="720"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="26">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.92*"/>
            <ColumnDefinition Width="1.08*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="12,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#004C58" Offset="0"/>
                    <GradientStop Color="#00899A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="42">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="48" Height="48" Padding="3" Background="White" CornerRadius="24">
                        <Image Source="/Assets/pcds-seal.png" Stretch="Uniform" AutomationProperties.Name="PCDS seal"/>
                    </Border>
                    <StackPanel Margin="13,3,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PCDS Library" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="DIGITAL LIBRARY SYSTEM" Margin="0,3,0,0" FontSize="10" FontWeight="SemiBold" Foreground="#D5F0EE"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,24">
                    <TextBlock Text="PCDS DIGITAL SERVICES" FontSize="11" FontWeight="Bold" Foreground="#D5F0EE"/>
                    <TextBlock Text="Your campus&#x0a;library, connected."
                               Margin="0,18,0,0"
                               FontSize="38"
                               FontWeight="SemiBold"
                               LineHeight="44"
                               TextWrapping="Wrap"
                               Foreground="White"/>
                    <TextBlock Margin="0,18,0,0"
                               MaxWidth="380"
                               Text="A secure workspace for library staff to manage books, borrowing requests, returns, and member services."
                               TextWrapping="Wrap"
                               LineHeight="24"
                               FontSize="14"
                               Foreground="#D5F0EE"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Height="1" Margin="0,0,0,14" Background="#FFFFFF30"/>
                    <TextBlock FontSize="12" Foreground="#D5F0EE" Text="Polytechnic College of Davao del Sur"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="0,12,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid MaxWidth="460" Margin="36,38" VerticalAlignment="Center">
                        <StackPanel x:Name="LoginPanel">
                            <TextBlock Text="Welcome back" FontSize="29" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Margin="0,8,0,28"
                                       Text="Sign in with your staff account to continue to the library."
                                       TextWrapping="Wrap"
                                       FontSize="14"
                                       Foreground="{StaticResource MutedBrush}"/>

                            <TextBlock Text="Staff email or ID" Margin="0,0,0,7" FontSize="12" FontWeight="SemiBold" Foreground="#31565C"/>
                            <TextBox x:Name="StaffEmailInput"
                                     Height="48"
                                     Margin="0,0,0,19"
                                     Padding="13,11"
                                     FontSize="14"
                                     AutomationProperties.Name="Staff email or ID"
                                     KeyDown="StaffEmailInput_KeyDown"/>

                            <TextBlock Text="Password" Margin="0,0,0,7" FontSize="12" FontWeight="SemiBold" Foreground="#31565C"/>
                            <PasswordBox x:Name="PasswordInput"
                                         Height="48"
                                         Margin="0,0,0,4"
                                         Padding="13,11"
                                         FontSize="14"
                                         AutomationProperties.Name="Password"
                                         KeyDown="PasswordInput_KeyDown"/>

                            <TextBlock x:Name="ErrorText"
                                       MinHeight="24"
                                       Margin="0,4,0,10"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="#A53636"
                                       AutomationProperties.LiveSetting="Assertive"/>

                            <Button x:Name="LoginButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="48"
                                    Content="Sign in"
                                    FontSize="14"
                                    Click="LoginButton_Click"/>
                            <Button Content="Register as librarian"
                                    Height="44"
                                    Margin="0,11,0,0"
                                    Background="White"
                                    Foreground="{StaticResource PrimaryDeepBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    Click="ShowRegistration_Click"/>
                        </StackPanel>

                        <StackPanel x:Name="RegistrationPanel" Visibility="Collapsed">
                            <TextBlock Text="Librarian registration" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Staff accounts require an administrator-issued registration code."
                                       Margin="0,7,0,22"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"/>

                            <TextBlock Text="Full name" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold" Foreground="#31565C"/>
                            <TextBox x:Name="RegisterNameInput" Height="42" Margin="0,0,0,12" AutomationProperties.Name="Full name"/>

                            <TextBlock Text="Staff ID" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold" Foreground="#31565C"/>
                            <TextBox x:Name="RegisterStaffIdInput" Height="42" Margin="0,0,0,12" AutomationProperties.Name="Staff ID"/>

                            <TextBlock Text="Work email" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold" Foreground="#31565C"/>
                            <TextBox x:Name="RegisterEmailInput" Height="42" Margin="0,0,0,12" AutomationProperties.Name="Work email"/>

                            <TextBlock Text="Password (at least 8 characters)" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold" Foreground="#31565C"/>
                            <PasswordBox x:Name="RegisterPasswordInput" Height="42" Margin="0,0,0,12" AutomationProperties.Name="Password"/>

                            <TextBlock Text="Confirm password" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold" Foreground="#31565C"/>
                            <PasswordBox x:Name="ConfirmPasswordInput" Height="42" Margin="0,0,0,12" AutomationProperties.Name="Confirm password"/>

                            <TextBlock Text="Staff registration code" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold" Foreground="#31565C"/>
                            <PasswordBox x:Name="StaffInviteCodeInput" Height="42" Margin="0,0,0,8" AutomationProperties.Name="Staff registration code"/>

                            <TextBlock x:Name="RegistrationErrorText"
                                       MinHeight="24"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="#A53636"
                                       AutomationProperties.LiveSetting="Assertive"/>
                            <Button x:Name="RegisterButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Create librarian account"
                                    Height="46"
                                    Click="RegisterButton_Click"/>
                            <Button Content="Back to sign in"
                                    Height="42"
                                    Margin="0,9,0,0"
                                    Click="ShowLogin_Click"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <views:ConnectionStatusControl Grid.Row="1" Margin="34,0,34,22"/>
            </Grid>
        </Border>
    </Grid>
</Window>
