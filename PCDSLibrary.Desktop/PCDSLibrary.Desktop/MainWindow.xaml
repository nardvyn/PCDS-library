<Window x:Class="PCDSLibrary.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PCDSLibrary.Desktop.Views"
        Title="PCDS Library"
        Width="950"
        Height="600"
        MinWidth="850"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#EEF4F8">

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="0.95*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE -->
        <Border Grid.Column="0"
                Background="#15577F"
                CornerRadius="20,0,0,20">

            <Grid Margin="45">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo and system name -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal">

                    <Border Width="50"
                            Height="50"
                            Background="#357493"
                            CornerRadius="12">

                        <TextBlock Text="📚"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="14,4,0,0">
                        <TextBlock Text="PCDS Library"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <TextBlock Text="Library Management System"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="#C9DFEA"/>
                    </StackPanel>
                </StackPanel>

                <!-- Welcome message -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="Welcome back."
                               FontSize="42"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Margin="0,15,0,0"
                               MaxWidth="390"
                               TextWrapping="Wrap"
                               LineHeight="25"
                               FontSize="15"
                               Foreground="#D8E8F0">

                        Manage books, borrowing requests, returns,
                        overdue records, and library reports.
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           FontSize="12"
                           Foreground="#BDD6E2"
                           Text="Polytechnic College of Davao del Sur"/>
            </Grid>
        </Border>

        <!-- RIGHT SIDE -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="0,20,20,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Width="330" VerticalAlignment="Center" Margin="0,28">
                                <StackPanel x:Name="LoginPanel">

                <TextBlock Text="Staff Sign In"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#172630"/>

                <TextBlock Margin="0,7,0,28"
                           FontSize="14"
                           Foreground="#687B86"
                           Text="For administrators and librarians only"/>

                <!-- Staff email or ID -->
                <TextBlock Text="Staff email or ID"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#172630"/>

                <TextBox x:Name="StaffEmailInput"
                         Height="46"
                         Margin="0,7,0,18"
                         Padding="13,11"
                         FontSize="14"
                         BorderBrush="#D5E1E7"
                         BorderThickness="1"
                         KeyDown="StaffEmailInput_KeyDown"/>

                <!-- Password -->
                <TextBlock Text="Password"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#172630"/>

                <PasswordBox x:Name="PasswordInput"
                             Height="46"
                             Margin="0,7,0,8"
                             Padding="13,11"
                             FontSize="14"
                             BorderBrush="#D5E1E7"
                             BorderThickness="1"
                             KeyDown="PasswordInput_KeyDown"/>

                <!-- Error message -->
                <TextBlock x:Name="ErrorText"
                           MinHeight="20"
                           Margin="0,5,0,12"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#B42318"/>

                <!-- Login button -->
                <Button x:Name="LoginButton"
                        Height="48"
                        Content="Sign in"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#15577F"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="LoginButton_Click"/>
                                <Button Content="Register as librarian"
                                                Height="40"
                                                Margin="0,12,0,0"
                                                Background="Transparent"
                                                Foreground="#15577F"
                                                BorderBrush="#D5E1E7"
                                                Click="ShowRegistration_Click"/>
                                </StackPanel>

                                <StackPanel x:Name="RegistrationPanel" Visibility="Collapsed">
                                        <TextBlock Text="Librarian Registration" FontSize="25" FontWeight="SemiBold" Foreground="#172630"/>
                                        <TextBlock Text="Staff accounts require an administrator-issued registration code." Margin="0,6,0,18" TextWrapping="Wrap" FontSize="13" Foreground="#687B86"/>

                                        <TextBlock Text="Full name" FontSize="12" FontWeight="SemiBold" Foreground="#172630"/>
                                        <TextBox x:Name="RegisterNameInput" Height="40" Margin="0,5,0,10" Padding="10,8"/>

                                        <TextBlock Text="Staff ID" FontSize="12" FontWeight="SemiBold" Foreground="#172630"/>
                                        <TextBox x:Name="RegisterStaffIdInput" Height="40" Margin="0,5,0,10" Padding="10,8"/>

                                        <TextBlock Text="Work email" FontSize="12" FontWeight="SemiBold" Foreground="#172630"/>
                                        <TextBox x:Name="RegisterEmailInput" Height="40" Margin="0,5,0,10" Padding="10,8"/>

                                        <TextBlock Text="Password (at least 8 characters)" FontSize="12" FontWeight="SemiBold" Foreground="#172630"/>
                                        <PasswordBox x:Name="RegisterPasswordInput" Height="40" Margin="0,5,0,10" Padding="10,8"/>

                                        <TextBlock Text="Confirm password" FontSize="12" FontWeight="SemiBold" Foreground="#172630"/>
                                        <PasswordBox x:Name="ConfirmPasswordInput" Height="40" Margin="0,5,0,10" Padding="10,8"/>

                                        <TextBlock Text="Staff registration code" FontSize="12" FontWeight="SemiBold" Foreground="#172630"/>
                                        <PasswordBox x:Name="StaffInviteCodeInput" Height="40" Margin="0,5,0,10" Padding="10,8"/>

                                        <TextBlock x:Name="RegistrationErrorText" MinHeight="20" Margin="0,0,0,8" TextWrapping="Wrap" FontSize="12" Foreground="#B42318"/>
                                        <Button x:Name="RegisterButton" Content="Create librarian account" Height="46" Background="#15577F" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="RegisterButton_Click"/>
                                        <Button Content="Back to sign in" Height="40" Margin="0,8,0,0" Background="Transparent" Foreground="#15577F" BorderBrush="#D5E1E7" Click="ShowLogin_Click"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                <views:ConnectionStatusControl Grid.Row="1" Margin="28,0,28,18"/>
            </Grid>
        </Border>
    </Grid>
</Window>
