<UserControl x:Class="PCDSLibrary.Desktop.Views.ConnectionStatusControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="180">
    <Border Padding="10,8" Background="#EFF8F7" BorderBrush="#CFE0E1" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Ellipse x:Name="ConnectionIndicator"
                     Width="9"
                     Height="9"
                     Margin="0,0,8,0"
                     Fill="#D99822"
                     VerticalAlignment="Center"/>
            <TextBlock x:Name="ConnectionText"
                       Grid.Column="1"
                       Text="Checking server..."
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="#31565C"
                       VerticalAlignment="Center"/>
            <Button x:Name="RetryButton"
                    Grid.Column="2"
                    Content="Retry"
                    Margin="8,0,0,0"
                    Padding="7,3"
                    FontSize="10"
                    Background="White"
                    Foreground="#006572"
                    BorderBrush="#CFE0E1"
                    Visibility="Collapsed"
                    Click="RetryButton_Click"/>
            <ProgressBar x:Name="ConnectionProgress"
                         Grid.Row="1"
                         Grid.ColumnSpan="3"
                         Height="4"
                         Margin="0,7,0,0"
                         IsIndeterminate="True"
                         Visibility="Visible"/>
        </Grid>
    </Border>
</UserControl>