<Window x:Class="PCDSLibrary.Desktop.Views.ModuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCDS Library"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#F3F7FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DCE6EB"
                BorderThickness="0,0,0,1">

            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Back"
                        Width="90"
                        Height="38"
                        Click="BackButton_Click"/>

                <StackPanel Grid.Column="1"
                            Margin="20,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="ModuleTitleText"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#172630"/>

                    <TextBlock x:Name="ModuleDescriptionText"
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="#687B86"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Refresh"
                        Width="90"
                        Height="38"
                        Click="RefreshButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="30"
                Padding="25"
                Background="White"
                CornerRadius="12">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock x:Name="ModuleIconText"
                           FontSize="45"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="EmptyMessageText"
                           Margin="0,15,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="This module is ready for its API and database functions."
                           Margin="0,8,0,0"
                           Foreground="#687B86"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
