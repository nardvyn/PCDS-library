<Window x:Class="PCDSLibrary.Desktop.Views.LibrarianDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PCDSLibrary.Desktop.Views"
        Title="PCDS Library - Dashboard"
        Width="1200"
        Height="720"
        MinWidth="1000"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#123E5A">
            <DockPanel Margin="20">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="PCDS Library"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Margin="0,6,0,20"
                               Text="Admin / Librarian"
                               FontSize="12"
                               Foreground="#BFD4E0"/>
                </StackPanel>

                <views:ConnectionStatusControl DockPanel.Dock="Bottom" Margin="0,12,0,0"/>

                <StackPanel>
                    <Button x:Name="DashboardButton" Content="Dashboard" Height="40" Margin="0,0,0,10" Background="#1A567A" Foreground="White" BorderThickness="0" Click="DashboardButton_Click"/>
                    <Button x:Name="BorrowRequestsButton" Height="36" Margin="0,0,0,8" Background="Transparent" Foreground="#E7F1F6" BorderBrush="#2A6284" Click="BorrowRequestsButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Borrow Requests" VerticalAlignment="Center"/>
                            <Border x:Name="PendingRequestsBadge" Width="20" Height="20" Margin="8,0,0,0" CornerRadius="10" Background="#F4C542" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock x:Name="PendingRequestsCountText" Text="0" Foreground="#3D310A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ActiveLoansButton" Content="Active Loans" Height="36" Margin="0,0,0,8" Background="Transparent" Foreground="#E7F1F6" BorderBrush="#2A6284" Click="ActiveLoansButton_Click"/>
                    <Button x:Name="BookReturnsButton" Content="Book Returns" Height="36" Margin="0,0,0,8" Background="Transparent" Foreground="#E7F1F6" BorderBrush="#2A6284" Click="BookReturnsButton_Click"/>
                    <Button x:Name="OverdueBooksButton" Content="Overdue Books" Height="36" Margin="0,0,0,8" Background="Transparent" Foreground="#E7F1F6" BorderBrush="#2A6284" Click="OverdueBooksButton_Click"/>
                    <Button x:Name="PenaltiesButton" Content="Penalties" Height="36" Margin="0,0,0,8" Background="Transparent" Foreground="#E7F1F6" BorderBrush="#2A6284" Click="PenaltiesButton_Click"/>
                    <Button x:Name="ManageBooksButton" Content="Manage Books" Height="36" Margin="0,0,0,8" Background="Transparent" Foreground="#E7F1F6" BorderBrush="#2A6284" Click="ManageBooksButton_Click"/>
                    <Button x:Name="BorrowersButton" Content="Borrowers" Height="36" Margin="0,0,0,8" Background="Transparent" Foreground="#E7F1F6" BorderBrush="#2A6284" Click="BorrowersButton_Click"/>
                    <Button x:Name="NotificationsButton" Content="Notifications" Height="36" Margin="0,0,0,8" Background="Transparent" Foreground="#E7F1F6" BorderBrush="#2A6284" Click="NotificationsButton_Click"/>
                    <Button x:Name="ReportsButton" Content="Reports" Height="36" Margin="0,0,0,8" Background="Transparent" Foreground="#E7F1F6" BorderBrush="#2A6284" Click="ReportsButton_Click"/>
                    <Button x:Name="UserManagementButton" Height="36" Margin="0,10,0,8" Background="Transparent" Foreground="#9AB7C9" BorderBrush="#2A6284" Click="UserManagementButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="User Management (Admin)" VerticalAlignment="Center"/>
                            <Border x:Name="PendingUsersBadge" Width="20" Height="20" Margin="8,0,0,0" CornerRadius="10" Background="#F4C542" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock x:Name="PendingUsersCountText" Text="0" Foreground="#3D310A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AuditLogsButton" Content="Audit Logs (Admin)" Height="36" Margin="0,0,0,8" Background="Transparent" Foreground="#9AB7C9" BorderBrush="#2A6284" Click="AuditLogsButton_Click"/>
                    <Button x:Name="SettingsButton" Content="Settings (Admin)" Height="36" Margin="0,0,0,18" Background="Transparent" Foreground="#9AB7C9" BorderBrush="#2A6284" Click="SettingsButton_Click"/>
                    <Button x:Name="SignOutButton" Content="Sign Out" Height="38" Background="#A11D1D" Foreground="White" BorderThickness="0" Click="SignOutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl x:Name="MainContent"
                        Grid.Column="1"
                        Margin="24"/>
    </Grid>
</Window>
