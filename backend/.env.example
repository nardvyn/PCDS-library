DATABASE_URL=mysql+pymysql://root:your-password@localhost:3306/pcds_library
# Optional local override when DATABASE_URL is a Railway private address:
LOCAL_DATABASE_URL=mysql+pymysql://root:your-password@localhost:3306/pcds_library
# Alternatively, use Railway's public TCP proxy URL when running from your PC:
# DATABASE_PUBLIC_URL=mysql+pymysql://user:password@public-host:public-port/railway
# MYSQL_PUBLIC_URL=mysql://user:password@public-host:public-port/railway
JWT_SECRET_KEY=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
STAFF_REGISTRATION_CODE=replace-with-a-private-random-invite-code
FRONTEND_URL=http://localhost:5173
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password-or-app-password
MAIL_DEFAULT_SENDER=library@example.com
LIBRARY_OFFICIAL_EMAIL=pcds.libraries@gmail.com
PENALTY_ALERT_EMAIL=pcds.libraries@gmail.com
MAIL_USE_TLS=true
MAIL_USE_SSL=false
